# Prisma / PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clearallergy"
# Prisma Migrate 用の直接接続先です。Neon を使う場合は pooler ではない direct URL を設定してください。
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/clearallergy"

# true の間は一般ユーザーの登録・更新をDBへ保存せず、閲覧専用デモへ流します。
# Clerk publicMetadata.role = "admin"、または下の許可リストに含まれるアプリ内 User.id のユーザーだけは実更新できます。
PORTFOLIO_MODE="true"
# カンマ区切りで指定します。コード側にもポートフォリオ編集用の既定 User.id があります。
PORTFOLIO_EDITOR_APP_USER_IDS=""

# 旧自己登録設定です。現在はコードで常にdisabledのため、値を変えても登録は開きません。
ADMIN_REGISTRATION_MODE="disabled"
# 旧自己登録用トークンです。現在のClerk招待受諾フローでは使用しません。
ADMIN_REGISTRATION_INVITE_TOKEN=""
# 管理画面で Google / Clerk SSO 導線を開く時だけ true にします。
# メールアドレス + パスワードの Clerk ログイン自体は常に有効です。
ENABLE_CLERK_ADMIN_AUTH="false"

# Clerk のキーです。管理ログインと管理API認可は Clerk が正本です。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# 管理画面のQRコード生成で使う公開URLのベースです。
# 未設定の場合はブラウザで開いている origin を使います。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 管理画面の店舗画像・メニュー画像アップロードを使う場合のみ必要です。
# Vercel Blob を使わない場合は空のままで構いません。
BLOB_READ_WRITE_TOKEN=""
# DB に保存してよい画像URLの prefix 一覧です。カンマ区切りで指定します。
# 自分のBlobストアのHTTPS URLだけを指定します。未設定時は上のトークンからストアを限定します。
# 他ストア・HTTP・独自配信ドメインは許可しません。設定変更後は再ビルドが必要です。
ALLOWED_IMAGE_URL_PREFIXES=""

# Google Maps JavaScript API用の公開キーです。HTTPリファラー制限を設定してください。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Advanced Markerで使うJavaScript Map IDです。
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
# 管理者の店舗候補検索用サーバーキーです。公開店舗検索からは使用しません。
GOOGLE_MAPS_SERVER_API_KEY=""
