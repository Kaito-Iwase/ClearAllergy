generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  // Clerk 移行時の互換用。現在のランタイム認証は Clerk セッションを正とします。
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Clerk ユーザーとアプリ内 User を結び付ける主キーです。
  clerkUserId  String?  @unique
  shop         Shop?
  auditLogs    AuditLog[]
}

model Shop {
  id                  String        @id @default(cuid())
  userId              String?       @unique
  // 現在の店舗所有者は Clerk user id で判定します。
  ownerClerkUserId    String?       @unique
  name                String
  description         String?
  address             String?
  hours               String?
  regularHoliday      String?
  phoneNumber         String?
  note                String?
  isActive            Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  coverImageUrl       String?
  coverImageFrame     String        @default("wide")
  coverImageFit       String        @default("cover")
  coverImagePosition  String        @default("center")
  coverImageZoom      Int           @default(100)
  coverImagePositionX Int           @default(50)
  coverImagePositionY Int           @default(50)
  averageBudgetYen    Int?
  adminInvites        AdminInvite[]
  menus               MenuItem[]
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AdminInvite {
  // 店舗管理者を Clerk 招待で追加するための管理テーブルです。
  id                    String       @id @default(cuid())
  email                 String
  shopId                String
  status                InviteStatus @default(pending)
  clerkInvitationId     String?      @unique
  expiresAt             DateTime?
  invitedByClerkUserId  String
  acceptedByClerkUserId String?
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  shop                  Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([shopId, status])
  @@index([status])
}

model AuditLog {
  // 認証、招待、メニュー更新などの管理操作を追跡します。
  id          String   @id @default(cuid())
  actorUserId String?
  actorShopId String?
  action      String
  targetType  String
  targetId    String?
  success     Boolean
  ipAddress   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([actorShopId])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([createdAt])
}

model MenuItem {
  id             String             @id @default(cuid())
  shopId         String
  name           String
  description    String?
  priceYen       Int?
  category       String?
  ingredients    String?
  precaution     String?
  imageUrl       String?
  imageFrame     String             @default("square")
  imageFit       String             @default("cover")
  imagePosition  String             @default("center")
  imageZoom      Int                @default(100)
  imagePositionX Int                @default(50)
  imagePositionY Int                @default(50)
  isPublished    Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shop           Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  allergenLinks  MenuItemAllergen[]

  @@index([shopId])
}

model Allergen {
  id        String             @id @default(cuid())
  slug      String             @unique
  nameJa    String
  nameEn    String
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  menuLinks MenuItemAllergen[]
}

model MenuItemAllergen {
  menuItemId String
  allergenId String
  // 未確認を安全側に扱うため、初期値は UNKNOWN にしています。
  status     AllergenStatus @default(UNKNOWN)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  allergen   Allergen       @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  menuItem   MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, allergenId])
  @@index([allergenId])
  @@index([menuItemId])
}

enum AllergenStatus {
  CONTAINS
  FREE
  MAY_CONTAIN
  UNKNOWN
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
  failed
}
