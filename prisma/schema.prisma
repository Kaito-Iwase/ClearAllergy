generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Clerk とひもづくアプリ内ユーザー情報
// まだ移行中なので clerkUserId は nullable
// 旧ログインも残すため passwordHash も一旦残す
model User {
  id           String   @id @default(cuid())
  clerkUserId  String?  @unique
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1店舗1アカウント：User 1 : 1 Shop
  shop Shop?
}

// 店舗情報（ユーザーに紐づく）
model Shop {
  id            String   @id @default(cuid())
  userId        String   @unique
  name          String
  description   String?  // 店の説明（任意）
  address       String?  // 住所（任意）
  hours         String?  // 営業時間（任意）
  coverImageUrl String?  // 店舗カバー画像URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  menus MenuItem[]
}

// メニュー（商品）
model MenuItem {
  id            String             @id @default(cuid())
  shopId        String
  name          String
  description   String?            // 商品説明（任意）
  priceYen      Int?               // 価格（任意）
  category      String?            // 自由入力カテゴリ
  ingredients   String?            // 原材料
  precaution    String?            // 注意書き
  imageUrl      String?            // 画像URL（Blob等に保存したURL）
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  allergenLinks MenuItemAllergen[]

  @@index([shopId])
}

// アレルゲン28品目マスタ
model Allergen {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameJa    String
  nameEn    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuLinks MenuItemAllergen[]
}

// 商品 × アレルゲン の中間テーブル
model MenuItemAllergen {
  menuItemId String
  allergenId String
  status     AllergenStatus @default(FREE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([menuItemId, allergenId])
  @@index([allergenId])
  @@index([menuItemId])
}

// 三択状態
enum AllergenStatus {
  CONTAINS
  FREE
  MAY_CONTAIN
}