generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clerkUserId  String?  @unique
  shop         Shop?
}

model Shop {
  id               String     @id @default(cuid())
  userId           String     @unique
  name             String
  description      String?
  address          String?
  hours            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  coverImageUrl    String?
  averageBudgetYen Int?
  menus            MenuItem[]
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id            String             @id @default(cuid())
  shopId        String
  name          String
  description   String?
  priceYen      Int?
  category      String?
  ingredients   String?
  precaution    String?
  imageUrl      String?
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  shop          Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  allergenLinks MenuItemAllergen[]

  @@index([shopId])
}

model Allergen {
  id        String             @id @default(cuid())
  slug      String             @unique
  nameJa    String
  nameEn    String
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  menuLinks MenuItemAllergen[]
}

model MenuItemAllergen {
  menuItemId String
  allergenId String
  status     AllergenStatus @default(UNKNOWN)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  allergen   Allergen       @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  menuItem   MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, allergenId])
  @@index([allergenId])
  @@index([menuItemId])
}

enum AllergenStatus {
  CONTAINS
  FREE
  MAY_CONTAIN
  UNKNOWN
}
